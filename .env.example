# Copy to .env and fill in values

# Razorpay (wallet top-up; UPI PhonePe/GPay etc. run inside Razorpay Checkout in the app)
RAZORPAY_KEY_ID=rzp_test_SnF32mVc6juGRY
RAZORPAY_KEY_SECRET=tcDuE9tTVlBDy1Itb6SYO468
# Dashboard → Webhooks → signing secret (for POST /api/v1/wallet/razorpay/webhook; event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Optional deep links / universal links your Flutter app handles after checkout (returned in create-order JSON).
# WALLET_TOPUP_SUCCESS_RETURN_URL=astrologer://wallet/topup/success
# WALLET_TOPUP_CANCEL_RETURN_URL=astrologer://wallet/topup/cancel

# Emergency / testing: 6-digit code that always works (no SMS). Set in production only if you accept the risk.
MASTER_OTP=123456

# DB: sync({ alter: true }) adds missing columns when NODE_ENV is not production.
# DB_SYNC_ALTER=false
# DB_SYNC_ALTER=true

# Exact MySQL column name for the user's profile image URL (users table).
# Code default is profile_image_url. If your column is camelCase profileImageUrl, set:
# USER_PROFILE_IMAGE_DB_COLUMN=profileImageUrl

# Agora (RTC voice/video) — get App ID & Certificate from https://console.agora.io/
# Never commit real certificates; set in .env locally / server secrets.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
